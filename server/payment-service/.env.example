# Server Configuration
PORT=5003
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/nexom_payments

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook Secret (Get this from Stripe CLI or Dashboard)
# stripe listen --forward-to localhost:5003/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here


# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:5173,https://yourapp.vercel.app