# Server Configuration
PORT=5003
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/nexom_payments

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook Secret (Get this from Stripe CLI or Dashboard)
# stripe listen --forward-to localhost:5003/api/v1/payments/webhook
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here


# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:5173,https://yourapp.vercel.app

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Booking service sync configuration
BOOKING_SERVICE_URL=http://localhost:8085
BOOKING_INTERNAL_TOKEN=shared_internal_token_between_booking_and_payment
BOOKING_SYNC_RETRY_INTERVAL_MS=15000
BOOKING_SYNC_RECONCILE_INTERVAL_MS=900000
BOOKING_SYNC_MAX_RETRIES=8
BOOKING_SYNC_BASE_DELAY_MS=30000
BOOKING_SYNC_MAX_DELAY_MS=1800000
BOOKING_SYNC_REQUEST_TIMEOUT_MS=5000
BOOKING_SYNC_BATCH_SIZE=50
